<%- include ('default/header.ejs') %>
  <div style="margin: 4px;">
    <header>
      <%- include ('report/header_report.ejs') %>
    </header>

    <!-- SECTION JUDUL -->
    <section>
      <table width="100%" style="width: 100%; padding: 0px; margin: 4px 0; border-spacing: 0px; border-style: solid; border-width: 1px 1px 1px 1px; border-color: #595959;">
        <tbody>
          <tr>
            <td style="padding: 4px; width: 100%; text-align: center;">
              <div style="font-weight: bold; font-size: 12pt; ">REKAPITULASI PELANGGARAN KELEBIHAN MUATAN <%= resumedata.intervalString %></div>  
              <div style="font-weight: bold; font-size: 12pt; ">
                <% if (resumedata.interval == 'tahun') { %>
                  <div><%= namauppkb.toUpperCase() %></div> 
                  <div>TAHUN <%= tahun %></div>
                <% } else { %>
                  <div><%= namauppkb.toUpperCase() %></div> 
                  <div>BULAN <%= blnText.toUpperCase() %> TAHUN <%= tahun %></div>
                <% } %>
              </div>  
            </td>
          </tr>                               
        </tbody>
      </table>      
    </section>

    <!-- SECTION TABEL -->
    <section>
      <table width="100%" style="width: 100%; font-size: 8pt; padding: 0px; margin-top: 2px; border-spacing: 0px; border-style: solid; border-width: 1px 0px 1px 1px; border-color: #595959;">
        <thead>
          <tr style="font-weight: bold;">
            <th rowspan="2" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              No 
            </th>
            <th rowspan="2" style="padding: 4px; width: 10%; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <span>Waktu</span>
              <br />
              <% if (resumedata.interval == 'bulan') { %>
                <span>(Tanggal)</span>
              <% } else  { %>
                <span>(Bulan)</span>
              <% } %>
            </th>
            <th rowspan="1" colspan="6" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              Kelebihan Muatan
            </th>
          </tr>
          <tr style="font-weight: bold;">
            <th style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              5-20% 
            </th>
            <th style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              21-40% 
            </th>
            <th style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              41-60% 
            </th>
            <th style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              61-80%
            </th>
            <th style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              81-100%
            </th>
            <th style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              > 100% 
            </th>
          </tr>
        </thead>
        <tbody>
          <% var total_range_5_20 = 0; %>
          <% var total_range_21_40 = 0; %>
          <% var total_range_41_60 = 0; %>
          <% var total_range_61_80 = 0; %>
          <% var total_range_81_100 = 0; %>
          <% var total_range_up_100 = 0; %>

          <% for (var i = 0; i < data.length; i++) { %>

          <% total_range_5_20 = Number(total_range_5_20) + Number(data[i].range_5_20 || 0) %>
          <% total_range_21_40 = Number(total_range_21_40) + Number(data[i].range_21_40 || 0) %>
          <% total_range_41_60 = Number(total_range_41_60) + Number(data[i].range_41_60 || 0) %>
          <% total_range_61_80 = Number(total_range_61_80) + Number(data[i].range_61_80 || 0) %>
          <% total_range_81_100 = Number(total_range_81_100) + Number(data[i].range_81_100 || 0) %>
          <% total_range_up_100 = Number(total_range_up_100) + Number(data[i].range_up_100 || 0) %>

          <tr>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= i+1 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <% if (resumedata.interval == 'bulan') { %>
                <%= moment(data[i].waktu).format('DD-MM-YYYY') %>
              <% } else  { %>
                <%= data[i].waktu %>
              <% } %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= data[i].range_5_20 || 0 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= data[i].range_21_40 || 0 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= data[i].range_41_60 || 0 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= data[i].range_61_80 || 0 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= data[i].range_81_100 || 0 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= data[i].range_up_100 || 0 %>
            </td>
          </tr>
          <% } %>
          <tr style="font-weight: bold; background-color: lightgray;">
            <td rowspan="1" colspan="2" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              TOTAL
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= total_range_5_20 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= total_range_21_40 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= total_range_41_60 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= total_range_61_80 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= total_range_81_100 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= total_range_up_100 %>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- SECTION FOOTER -->
    <section>
      <table width="100%" style="width: 100%; font-size: 9pt; padding: 0px; margin-top: 2px; border-spacing: 0px;">
        <tbody>
          <td colspan="2" style="width: 50%; padding: 4px; border-spacing: 0px; text-align: left; vertical-align: top; font-size: 12px;">
            &nbsp;            
          </td>
          <td style="width: 20%; padding: 4px; border-spacing: 0px; text-align: center;">
            &nbsp;
          </td>
          <td style="width: 30%; padding: 4px; border-spacing: 0px; text-align: center;">
            <div style="border: dotted 1px #cccccc; margin-top: 2px;">
              <div><%= namauppkb.toUpperCase() %>, <%= moment().format('DD - MM - YYYY') %></div>
              <div><b>KORSATPEL</b></div>
              <div style="height: 48px;">&nbsp;</div>
              <% if (korsatpel != '') { %>
              <div>
                <b>( <%= korsatpel.nama.toUpperCase() %> )</b>
              </div>
              <div><%= korsatpel.pangkat %></div>
              <div>NIP. <%= korsatpel.nip %></div>
              <% } else { %>
              <div>
                <b>( ................................... )</b>
              </div>  
              <div>Pangkat / Golongan</div>
              <div>NIP. ...................................</div>
              <% } %>
            </div>
          </td>
          <td style="width: 5%; padding: 4px; border-spacing: 0px; text-align: center;">
            &nbsp;
          </td>
        </tbody>
      </table>
    </section>
  </div>  
<%- include ('default/footer.ejs') %>