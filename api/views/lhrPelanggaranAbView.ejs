<%- include ('default/header.ejs') %>
  <div style="margin: 4px;">
    <header>
      <%- include ('report/header_report.ejs') %>
    </header>
    <section>
      <table width="100%" style="width: 100%; padding: 0px; margin-top: 2px; border-spacing: 0px; border-style: solid; border-width: 1px 1px 1px 1px; border-color: #595959;">
        <tbody>
          <tr>
            <td style="font-weight: bold; width: 10%; padding: 4px; vertical-align: bottom;">
              <div style="font-size: 10px; ">UPPKB</div>  
            </td>
            <td style="font-weight: bold; padding: 4px; vertical-align: bottom;">
              <div style="font-size: 10px;">: 
                <% if (lokasi_id) { %>
                <%= lokasi.nama.toUpperCase() %>
                <% } else { %>
                SEMUA UPPKB
                <% } %>
              </div>
            </td>
            <td rowspan="4" style="text-align: right;">
              <img src="<%= qr %>" width="78" height="78" />
              <p style="font-size: 8px; font-style: italic; margin: 0; padding: 0px 6px 0px 0px;"><%= moment().format('DD-MM-YYYY') %></p>
            </td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 4px; width: 10%; vertical-align: top;">
              <div style="font-size: 10px; ">INTERVAL</div>  
            </td>
            <td style="font-weight: bold; padding: 4px; width: 75%; vertical-align: top;">
              <div style="font-size: 10px;">: <%= datafilter.interval %></div>
            </td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 4px; width: 10%; vertical-align: top;">
              <div style="font-size: 10px; ">
                WAKTU
              </div>  
            </td>
            <td style="font-weight: bold; padding: 4px; width: 75%; vertical-align: top;">
              <div style="font-size: 10px;">: 
                <% if (interval == 1 || interval == 2) { %>
                  <%= datafilter.tanggal %> <%= datafilter.jam_awal %> s.d <%= datafilter.jam_akhir %>
                <% } else if (interval == 3 || interval == 4  || interval == 5) { %>
                  <%= datafilter.jam_awal %> s.d <%= datafilter.jam_akhir %>
                <% } else { %>
                  <%= datafilter.jam_awal %>
                <% } %>
              </div>
            </td>
          </tr>                            
        </tbody>
      </table>
    </section>

    <section>
      <table width="100%" style="width: 100%; font-size: 9px; padding: 0px; margin-top: 2px; border-spacing: 0px; border-style: solid; border-width: 1px 0px 1px 1px; border-color: #595959;">
        <thead>
          <tr style="font-weight: bold;">
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              NO
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              WAKTU
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              UPPKB
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              PICKUP
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUK BOX KECIL
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUK BOX BESAR
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUCK STANDART KECIL
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUCK STANDART BESAR
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUCK TANGKI KECIL
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUCK TANGKI BESAR
            </td> 
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUCK DUMP KECIL
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUCK DUMP BESAR
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUCK TRAILER
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              TRUCK MIXER
            </td>                                                            
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              UNDEFINED
            </td>                                                                                                                                                   
          </tr>                               
        </thead>
        <tbody>
          <% var T_PICKUP = 0; %> 
          <% var T_TRUK_BOX_KECIL = 0; %>
          <% var T_TRUK_BOX_BESAR = 0; %>
          <% var T_TRUCK_STANDART_KECIL = 0; %>
          <% var T_TRUCK_STANDART_BESAR = 0; %>
          <% var T_TRUCK_TANGKI_KECIL = 0; %>
          <% var T_TRUCK_TANGKI_BESAR = 0; %>
          <% var T_TRUCK_DUMP_KECIL = 0; %>
          <% var T_TRUCK_DUMP_BESAR = 0; %>
          <% var T_TRUCK_TRAILER = 0; %>
          <% var T_TRUCK_MIXER = 0; %>
          <% var T_UNDEFINED = 0; %>

          <% for (var i = 0; i < data.length; i++) { %>

          <% T_PICKUP = T_PICKUP + Number(data[i].PICKUP); %>
          <% T_TRUK_BOX_KECIL = T_TRUK_BOX_KECIL + Number(data[i].TRUK_BOX_KECIL); %>
          <% T_TRUK_BOX_BESAR = T_TRUK_BOX_BESAR + Number(data[i].TRUK_BOX_BESAR); %>
          <% T_TRUCK_STANDART_KECIL = T_TRUCK_STANDART_KECIL + Number(data[i].TRUCK_STANDART_KECIL); %>
          <% T_TRUCK_STANDART_BESAR = T_TRUCK_STANDART_BESAR + Number(data[i].TRUCK_STANDART_BESAR); %>
          <% T_TRUCK_TANGKI_KECIL = T_TRUCK_TANGKI_KECIL + parseFloat(data[i].TRUCK_TANGKI_KECIL); %>
          <% T_TRUCK_TANGKI_BESAR = T_TRUCK_TANGKI_BESAR + Number(data[i].TRUCK_TANGKI_BESAR); %>
          <% T_TRUCK_DUMP_KECIL = T_TRUCK_DUMP_KECIL + Number(data[i].TRUCK_DUMP_KECIL); %>
          <% T_TRUCK_DUMP_BESAR = T_TRUCK_DUMP_BESAR + Number(data[i].TRUCK_DUMP_BESAR); %>
          <% T_TRUCK_TRAILER = T_TRUCK_TRAILER + Number(data[i].TRUCK_TRAILER); %>
          <% T_TRUCK_MIXER = T_TRUCK_MIXER + Number(data[i].TRUCK_MIXER); %>
          <% T_UNDEFINED = T_UNDEFINED + Number(data[i].UNDEFINED); %>

          <tr>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= i+1 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <% if (interval == 1 || interval == 2) { %>
                <%  if (Number(moment(data[i].waktu_to, 'HH:mm').format('HH')) == 0 && Number(moment(data[i].waktu_to, 'HH:mm').format('mm')) == 0) { %>
                    <%= `${data[i].waktu_from} - 23:59` %>
                <%  } else { %>
                    <%= `${data[i].waktu_from} - ${data[i].waktu_to}` %>
                  <% } %>
              <% } %>

              <% if (interval == 3) { %>
                <%= moment(data[i].waktu, 'DD-MM-YYYY').locale('id').format('DD-MM-YYYY') %>
              <% } %>              

              <% if (interval == 4) { %>
                <%= moment(data[i].waktu, 'MM-YYYY').locale('id').format('MMMM') %>
              <% } %>

              <% if (interval == 5) { %>
                <%= moment(data[i].waktu, 'YYYY-MM-DD').locale('id').format('YYYY') %>
              <% } %>


            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].nama_uppkb %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].PICKUP %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUK_BOX_KECIL %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUK_BOX_BESAR %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUCK_STANDART_KECIL %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUCK_STANDART_BESAR %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUCK_TANGKI_KECIL %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUCK_TANGKI_BESAR %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUCK_DUMP_KECIL %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUCK_DUMP_BESAR %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUCK_TRAILER %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].TRUCK_MIXER %>
            </td>                                                                                    
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= data[i].UNDEFINED %>
            </td>                
          </tr>
          <% } %>
          <tr style="font-weight: bold;">
            <td colspan="3" style="font-weight: bold; padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              Total
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_PICKUP %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUK_BOX_KECIL %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUK_BOX_BESAR %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUCK_STANDART_KECIL %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUCK_STANDART_BESAR %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUCK_TANGKI_KECIL %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUCK_TANGKI_BESAR %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUCK_DUMP_KECIL %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUCK_DUMP_BESAR %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUCK_TRAILER %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_TRUCK_MIXER %>
            </td>                                                                                    
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <%= T_UNDEFINED %>
            </td>                
          </tr>          
        </tbody>
      </table>      
    </section>
  </div>

<%- include ('default/footer.ejs') %>