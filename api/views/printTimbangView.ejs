<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Print Hasil Penimbangan</title>
  <!-- <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous"> -->
  <style>
    body { 
	padding: 4px 4px;
	font-family: Arial, Helvetica, sans-serif;
    };
    .col-md-2 {
      width: 20%;
    }
    .col-md-4 {
      width: 40%;
    }
    /* @media print {
      @page {                
        size: A4;
        margin: 10mm;
      }

      html, body {
        width: 1024px;
	font-family: Arial, Helvetica, sans-serif;
      }

      body {
        margin: 0 auto;
      }
    } */
  </style>
</head>
<body>

  <div style="margin: 2px;">
    <header>
      <table width="100%" style="border-bottom: solid 2px #000000;">
        <tbody>
          <tr>
            <td style="width: 10%;">
                <img src="<%= logo %>" width="64" height="66" />
            </td>
            <td style="width: 80%; font-weight: bold;">
                <div style="font-size: 12px;">KEMENTERIAN PERHUBUNGAN</div>
                <div style="font-size: 12px;">DIREKTORAT JENDERAL PERHUBUNGAN DARAT</div>
                <div style="font-size: 12px;"><%= data.nama_bptd.toUpperCase() %></div>
                <div style="font-size: 9px;">SATUAN PELAYANAN <%= data.nama_uppkb.toUpperCase() %></div>
                <div style="font-size: 8px;"><%= data.alamat_uppkb %></div>                
            </td>
            <td style="width: 10%;"><img src="<%= qr %>" width="66" height="66" /></td>
          </tr>
        </tbody>
      </table>
    </header>
    <!-- <table width="100%" style="border-bottom: solid 2px #000000;">
      <tbody>
        <tr>
          <td style="font-weight: bold; padding: 4px;">
              <div style="font-size: 10px;"><%= data.nama_bptd.toUpperCase() %></div>
              <div style="font-size: 10px;">SATUAN PELAYANAN <%= data.nama_uppkb.toUpperCase() %></div>
              <div style="font-size: 9px;"><%= data.alamat_uppkb %></div>
          </td>
        </tr>
      </tbody>
    </table> -->
    <table style="width: 100%; text-align: center;">
      <tr>
        <td colspan="3" style="text-align: center; font-weight: bold; padding: 4px;">
            <div style="font-size: 10pt; text-decoration: underline; text-align: center;">BUKTI PENIMBANGAN</div>
            <div style="font-size: 10pt; text-align: center;"><%= data.kode_trx %></div>
        </td>
      </tr>
    </table>
    <table class="table borderless" style="font-size: 11pt; margin-top: 11px;">
      <tbody>
        <tr>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Tanggal</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.tanggal %></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Jam</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.jam %></td>
        </tr>
        <tr>
          <td style="width: 20%; padding: 1px; font-weight: bold;">No Kendaraan</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.no_kendaraan %></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td style="width: 20%; padding: 1px; font-weight: bold;">No Uji</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.no_uji %></td>
        </tr>

        <tr>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Pemilik</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.nama_pemilik %></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td style="width: 20%; padding: 1px; font-weight: bold;">JBI</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;">
            <% if (Number(data.gandengan_jbki) > 0) { %>
                <%= data.gandengan_jbki %> Kg
            <% } else { %>
              <%= data.jbi %> Kg
            <% } %>
          </td>
        </tr>
        <tr>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Alamat</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;">
            <% if (data.alamat_pemilik != 'undefined' && data.alamat_pemilik != '') { %>
            <%= data.alamat_pemilik %>
            <% } else { %>
              <span>-</span>
            <% } %>
          </td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Berat Timbangan</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;">
              <% if (data.berat_timbang == 'NaN') { %>
                0 Kg
              <% } else { %>
                <%= data.berat_timbang %> Kg
              <% } %>
          </td>
        </tr>
        <tr>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Masa Berlaku</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.tgl_masa_berlaku %></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Berat Lebih</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.kelebihan_berat %> Kg (<%= data.persen_lebih %> %)</td>
        </tr>
        <tr>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Kota Asal</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.asal_kota %></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Kota Tujuan</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.tujuan_kota %></td>
        </tr>
        <tr>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Muatan</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.muatan %></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td style="width: 20%; padding: 1px; font-weight: bold;">Pelanggaran</td>
          <td>:</td>
          <td style="width: 40%; padding: 1px; font-weight: bold;"><%= data.pelanggaran %></td>
        </tr>                                
      </tbody>
    </table>
    <div style="border-bottom: solid 1px #cccccc;">&nbsp;</div>
    <table style="width: 100%;">
      <tbody>
        <tr>
          <td style="width: 50%; font-size: 11px; font-weight: bold; text-align: center; vertical-align: top;">
            <div>
              <p>PENGEMUDI</p>
              <p>&nbsp;</p>
              <div style="margin: 0px; text-decoration: underline;">( ____________________ )</div>
              
	      <!--<div style="margin-top: 0px;">
		&nbsp;
              </div>-->
            </div>
          </td>
          <td style="width: 50%; font-size: 11px; font-weight: bold; text-align: center; vertical-align: top;">
            <div>
              <p>OPERATOR</p>
              <p>&nbsp;</p>
              <div style="margin: 0px; text-decoration: underline; text-transform: uppercase;">( <%= data.petugas %> )</div>
              <!--<div style="margin-top: 0px;">
                <% if (data.nippetugas == '') { %>
                  &nbsp;NIP. <%= data.nippetugas %>
                <% } %>
              </div>-->
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

</body>
</html>
