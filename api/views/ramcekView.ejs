        <tr>
          <td colspan='8' style='font-size: 9px;'><b>DATA PEMERIKSAAN</b></td>
        </tr>
        <tr>
          <td>1.</td>
          <td>Hari/Tanggal</td>
          <td style='text-align: center;'>:</td>
          <td>
            <%= moment(data.tgl_pemeriksaan).locale("id").format('dddd / DD-MM-YYYY') %>
          </td>
          <td>6.</td>
          <td>Nama Perusahaan</td>
          <td style='text-align: center;'>:</td>
          <td></td>
        </tr>
        <tr>
          <td>2.</td>
          <td>Lokasi</td>
          <td style='text-align: center;'>:</td>
          <td style='text-align: left;'>
            <% if(data.detailramcek_uppkb) { %> 
              <img src="<%= checked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
              <span style="vertical-align: middle; margin-left: 2px;">UPPKB</span>
              &nbsp;
              <img src="<%= unchecked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
              <span style="vertical-align: middle; margin-left: 2px;">Lainnya</span>
            <% } else { %>
              <img src="<%= unchecked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
              <span style="vertical-align: middle; margin-left: 2px;">UPPKB</span>
              &nbsp;
              <img src="<%= checked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
              <span style="vertical-align: middle; margin-left: 2px;">Lainnya</span>
            <% } %> 
          </td>
          <td>7.</td>
          <td>Nomor Kendaraan</td>
          <td style='text-align: center;'>:</td>
          <td style='text-align: left; font-weight: bold;'>
            <span style="vertical-align: middle; margin-left: 2px;"><%= data.no_kendaraan %></span>
            <span style='margin-left: 2px;'>
              <% if(data.no_kend_value == 1) { %> 
                <img src="<%= checked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
                <span style="vertical-align: middle; margin-left: 2px;">Reguler</span>
                &nbsp;
                <img src="<%= unchecked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
                <span style="vertical-align: middle; margin-left: 2px;">Cadangan</span>
              <% } else { %>
                <img src="<%= unchecked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
                <span style="vertical-align: middle; margin-left: 2px;">Reguler</span>
                &nbsp;
                <img src="<%= checked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
                <span style="vertical-align: middle; margin-left: 2px;">Cadangan</span>
