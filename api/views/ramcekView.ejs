          <td>Nama Lokasi</td>
          <td style='text-align: center;'>:</td>
          <td style='font-size: 8px; font-weight: bold;'>
            <% if (data.detailramcek_uppkb) { %>
            <%= data.detailramcek_uppkb.nama.toUpperCase() %>
            <% } %>
