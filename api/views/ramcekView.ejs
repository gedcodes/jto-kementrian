            <img src="<%= unchecked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
            <span style="vertical-align: middle; margin-left: 2px;">Mobil Tangki</span>
            <img src="<%= unchecked %>" width="12" height="12" style="vertical-align: middle; margin-left: 2px;" />
            <span style="vertical-align: middle; margin-left: 2px;">Mobil Penarik</span>
