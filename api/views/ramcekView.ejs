<%- include ('default/header.ejs') %>

  <div style="font-family: Arial; font-size: 9px; margin: 4px;">
    <header>
      <%- include ('report/header_report.ejs') %>
    </header>

    <!-- SECTION UPPKB / TANGGAL -->
    <section>
      <table width="100%"
        style="width: 100%; padding: 0px; margin-top: 4px; border-spacing: 0px; border-style: solid; border-width: 1px 1px 1px 1px; border-color: #595959;">
        <tbody>
          <tr>
            <td style="font-weight: bold; width: 10%; padding: 4px; vertical-align: bottom;">
              <div style="font-size: 9px; ">UPPKB</div>
            </td>
            <td style="font-weight: bold; padding: 4px; vertical-align: bottom;">
              <div style="font-size: 9px;">: <%= data.detailramcek_uppkb.nama.toUpperCase() %>
              </div>
            </td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 4px; width: 10%; vertical-align: top;">
              <div style="font-size: 9px; ">TANGGAL</div>
            </td>
            <td style="font-weight: bold; padding: 4px; width: 75%; vertical-align: top;">
              <div style="font-size: 9px;">: <%= moment(data.tgl_pemeriksaan).format('DD-MM-YYYY') %>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- SECTION JUDUL FORMULIR -->
    <section>
      <table width="100%"
        style="width: 100%; padding: 0px; margin-top: 4px; border-spacing: 0px; border-style: solid; border-width: 1px 1px 1px 1px; border-color: #595959;">
        <tbody>
          <tr>
            <td style="padding: 4px; text-align: center; background-color: rgb(230, 230, 230);">
              <div style="font-size: 10pt; ">
                <b>
                  FORMULIR PEMERIKSAAN TEKNIS KENDARAAN ANGKUTAN BARANG
                </b>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- SECTION DATA PEMERIKSAAN -->
