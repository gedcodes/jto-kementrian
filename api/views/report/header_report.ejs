<table
    style="width: 100%; padding: 0px; border-spacing: 0px; border-style: solid; border-width: 1px 0px 1px 1px; border-color: #595959;">
    <tbody>
        <tr style="border-bottom: solid 1px #595959;">
            <td rowspan="4"
                style="width: 5%; padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 0px 0px; border-color: #595959; text-align: center;">
                <img src="<%= logo %>" width="72" height="76" /></td>
            <td rowspan="4" 
                style="width: 95%; padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 0px 0px; border-color: #595959; text-align: left; vertical-align: middle;">
                <div style="font-size: 14pt; font-weight: bold;"><%= headerJudul %></div>
                <div style="font-size: 14pt; font-weight: bold;"><%= headerSubjudul %></div>
            </td>
        </tr>
    </tbody>
</table>