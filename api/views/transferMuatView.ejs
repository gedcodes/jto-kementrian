<%- include ('default/header.ejs') %>
  <div style="margin: 4px;">
    <header>
      <%- include ('report/header_report.ejs') %>
    </header>
    <section>
      <table width="100%" style="width: 100%; padding: 0px; margin-top: 2px; border-spacing: 0px; border-style: solid; border-width: 1px 1px 1px 1px; border-color: #595959;">
        <tbody>
          <tr>
            <td style="font-weight: bold; width: 10%; padding: 4px; vertical-align: bottom;">
              <div style="font-size: 8px; ">UPPKB</div>  
            </td>
            <td style="font-weight: bold; padding: 4px; vertical-align: bottom;">
              <div style="font-size: 8px;">: 
                <% if (lokasi_id) { %>
                  <%= lokasi.nama.toUpperCase() %>
                <% } else { %>
                  SEMUA UPPKB
                <% } %>
              </div>
            </td>
            <td rowspan="4" style="text-align: right;">
              <img src="<%= qr %>" width="86" height="86" />
            </td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 4px; width: 10%; vertical-align: top;">
              <div style="font-size: 8px; ">TANGGAL</div>  
            </td>
            <td style="font-weight: bold; padding: 4px; width: 75%; vertical-align: top;">
              <div style="font-size: 8px;">: <%= tanggal_awal %> s.d <%= tanggal_akhir %></div>
            </td>
          </tr> 
          <% if (is_cond) { %>
          <tr>
            <td style="font-weight: bold; padding: 4px; width: 10%; vertical-align: top;">
              <div style="font-size: 8px; ">SHIFT</div>  
            </td>
            <td style="font-weight: bold; padding: 4px; width: 75%; vertical-align: top;">
              <div style="font-size: 8px;">: <%= resumedata.shift %></div>
            </td>
          </tr> 
          <tr>
            <td style="font-weight: bold; padding: 4px; width: 10%; vertical-align: top;">
              <div style="font-size: 8px; ">REGU</div>  
            </td>
            <td style="font-weight: bold; padding: 4px; width: 75%; vertical-align: top;">
              <div style="font-size: 8px;">: <%= resumedata.regu %></div>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </section>
    <section>
      <table width="100%" style="width: 100%; padding: 0px; margin-top: 2px; border-spacing: 0px; border-style: solid; border-width: 1px 1px 1px 1px; border-color: #595959;">
        <tbody>
          <tr>
            <td style="padding: 4px; width: 25%; text-align: center;">
              <div style="font-size: 10px; ">Jumlah Melanggar > 20% : <%= resumedata.jmlMelanggar %></div>  
            </td>
            <td style="padding: 4px; text-align: center;">
              <div style="font-size: 10px;">Jumlah Turun Muatan : <%= resumedata.jmlTurunMuatan %></div>
            </td>
            <td style="padding: 4px; width: 25%; text-align: center;">
              <div style="font-size: 10px;">Jumlah Lansir Muatan : <%= resumedata.jmlLansirMuatan %></div>
            </td>
          </tr>                               
        </tbody>
      </table>      
    </section>

    <section>
      <table width="100%" style="width: 100%; font-size: 9px; padding: 0px; margin-top: 2px; border-spacing: 0px; border-style: solid; border-width: 1px 0px 1px 1px; border-color: #595959;">
        <thead>
          <tr style="font-weight: bold;">
            <td rowspan="2" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              NO
            </td>
            <td rowspan="2" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              STATUS
            </td>
            <td rowspan="2" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              WAKTU
            </td>
            <% if (lokasi.length == 0) { %>
            <td rowspan="2" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              UPPKB
            </td>
            <% } %>
            <td rowspan="1" colspan="5" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              KENDARAAN MELANGGAR > 20 %
            </td>
            <td rowspan="1" colspan="5" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              KENDARAAN LANSIRAN
            </td>
            <% if (is_cond) { %>
            <td rowspan="2" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              SHIFT
            </td>
            <td rowspan="2" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              REGU
            </td>
            <% } %>
            <td rowspan="2" style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              OPERATOR
            </td>
          </tr>
          <tr style="font-weight: bold;">
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              KENDARAAN
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              JBI / PENIMBANGAN
            </td>            
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              HASIL TIMBANG ULANG (Kg)
            </td>            
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              BERAT LEBIH ULANG (Kg)
            </td> 
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              % LEBIH
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              KENDARAAN
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              JBI (Kg)
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              HASIL TIMBANGAN (Kg)
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              BERAT LEBIH (Kg)
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              % LEBIH
            </td>  
          </tr>
        </thead>
        <tbody>
          <% for (var i = 0; i < data.length; i++) { %>
          <tr>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= i+1 %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <% if (data[i].is_turun_muatan == true) { %>
                <span>TURUN MUATAN</span>
              <% } else { %>
                <span>LANSIR MUATAN</span>
              <% } %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= moment(data[i].tgl_transfer_muat).format('DD-MM-YYYY HH:mm:ss') %>
            </td>
            <% if (lokasi.length == 0) { %>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: lef;">
              <%= data[i].transfermuat_uppkb.nama.toUpperCase() %>
            </td>
            <% } %>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <div>No Kendaraan : <span style="font-weight: 600;"><%= data[i].no_kendaraan %></span></div>
              <div>No Uji : <span style="font-weight: 600;"><%= data[i].no_uji %></span></div>
              <div><span style="font-weight: 600;"><%= data[i].jenis_kendaraan %></span> - <span style="font-weight: 600;"><%= data[i].sumbu %></span></div>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <div>JBI : <span style="font-weight: 600;"><%= data[i].jbi_uji %></span> Kg</div>
              <div>Penimbangan : <span style="font-weight: 600;"><%= data[i].berat_timbang %></span> Kg</div>
              <div>Berat Lebih : <span style="font-weight: 600;"><%= data[i].berat_lebih %></span> Kg (<span style="font-weight: 600;"><%= data[i].persen_lebih %> %</span>)</div> 
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= data[i].berat_timbang_ulang %> 
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= data[i].berat_lebih_ulang %> 
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= data[i].persen_lebih_ulang %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: left;">
              <% if (data[i].is_turun_muatan == true) { %>
                <span>-</span>
              <% } else { %>
                <div>No Kendaraan : <span style="font-weight: 600;"><%= data[i].no_kendaraan_lansiran %></span></div>
                <div>No Uji : <span style="font-weight: 600;"><%= data[i].no_uji_lansiran %></span></div>
                <div><span style="font-weight: 600;"><%= data[i].jenis_kendaraan_lansiran %></span> - <span style="font-weight: 600;"><%= data[i].sumbu_lansiran %></span></div>
              <% } %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= data[i].jbi_lansiran %> 
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= data[i].berat_timbang_lansiran %> 
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= data[i].berat_lebih_lansiran %> 
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: right;">
              <%= data[i].persen_lebih_lansiran %>
            </td>
            <% if (is_cond) { %>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= data[i].transfermuat_shift.nama %>
            </td>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <%= data[i].transfermuat_regu.nama %>
            </td>
            <% } %>
            <td style="padding: 4px; border-spacing: 0px; border-style: solid; border-width: 0px 1px 1px 0px; border-color: #595959; text-align: center;">
              <% if (data[i].transfermuat_petugas) { %>
              <%= data[i].transfermuat_petugas.nama %>
              <% } %>
            </td>                        
          </tr>
          <% } %>
        </tbody>
      </table>      
    </section>

    <% if (is_cond) { %>
      <section>
        <table width="100%" style="width: 100%; font-size: 9pt; padding: 0px; margin-top: 2px; border-spacing: 0px;">
          <tbody>
            <td style="width: 30%; padding: 4px; border-spacing: 0px; text-align: center;">
              &nbsp;
            </td>
            <td style="width: 30%; padding: 4px; border-spacing: 0px; text-align: center;">
              &nbsp;
            </td>
            <td style="width: 20%; padding: 4px; border-spacing: 0px; text-align: center;">
              &nbsp;
            </td>
            <td style="width: 20%; padding: 4px; border-spacing: 0px; text-align: center; font-size: 10px;">
              <div style="border: dotted 1px #cccccc; margin-top: 2px;">
                <div style="padding-top: 6px;"><%= lokasi.nama %>, <span style="font-weight: bold;"><%= moment().format('DD - MM - YYYY') %></span></div>
                <% if (Object.keys(danru).length > 0) { %>
                  <div><b>KETUA REGU</b></div>
                  <div style="height: 64px;">&nbsp;</div>
                  <% if (danru.nama) { %>
                  <div>
                    <b>( <%= danru.nama.toUpperCase() %> )</b>
                  </div>
                  <div><%= danru.pangkat %></div>
                  <div>NIP. <%= danru.nip %></div>
                  <% } else { %>
                  <div>
                    <b>( ................................... )</b>
                  </div>  
                  <div>Pangkat / Golongan</div>
                  <div>NIP. ...................................</div>
                  <% } %>
                <% } else { %>
                  <div><b>KORSATPEL</b></div>
                  <div style="height: 64px;">&nbsp;</div>
                  <% if (korsatpel.nama) { %>
                  <div>
                    <b>( <%= korsatpel.nama.toUpperCase() %> )</b>
                  </div>
                  <div><%= korsatpel.pangkat %></div>
                  <div>NIP. <%= korsatpel.nip %></div>
                  <% } else { %>
                  <div>
                    <b>( ................................... )</b>
                  </div>  
                  <div>Pangkat / Golongan</div>
                  <div>NIP. ...................................</div>
                  <% } %>
                <% } %>
              </div>
            </td>
            <td style="width: 5%; padding: 4px; border-spacing: 0px; text-align: center;">
              &nbsp;
            </td>
          </tbody>
        </table>
      </section>
      <% } %>
  </div>

<%- include ('default/footer.ejs') %>