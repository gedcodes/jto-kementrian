{
  "name": "jtopusat-api",
  "version": "1.0.0",
  "author": "Noviehp",
  "license": "MIT",
  "scripts": {
    "postinstall": "husky install",
    "project": "node ./scripts/index.js",
    "dev": "cross-env NODE_ENV=production node ./api/api.js",
    "lint": "eslint ./api/. ./config/. ./test/.",
    "start": "npm run nodemon",
    "nodemon": "nodemon --exec npm run dev",
    "pretest": "npm run lint",
    "production": "cross-env NODE_ENV=production node ./api/api.js",
    "nms": "cross-env node ./middleware/nms.middleware.js",
    "wimblue": "cross-env node ./middleware/wimblue.middleware.js",
    "wimsync": "cross-env node ./middleware/wimsync.middleware.js",
    "mqtt": "cross-env node ./middleware/mqtt.middleware.js",
    "provdata": "cross-env node ./middleware/provdata.middleware.js",
    "scrapdata": "cross-env node ./middleware/scraper.middleware.js",
    "syncetilang": "cross-env node ./middleware/syncetilang.middleware.js",
    "syncpenimbangan": "cross-env node ./middleware/syncpenimbangan.middleware.js",
    "syncpenindakan": "cross-env node ./middleware/syncpenindakan.middleware.js",
    "getkendaraanblue": "cross-env node ./middleware/getkendaraanblue.middleware.js",
    "synckendaraanblue": "cross-env node ./middleware/synckendaraanblue.middleware.js",
    "synckendaraanlokal": "cross-env node ./middleware/synckendaraanlokal.middleware.js",
    "statusoperasi": "cross-env node ./middleware/monituppkb.middleware.js",
    "syncdeteksi": "cross-env node ./middleware/syncdeteksiverifikator.middleware.js",
    "syncverifikasipelanggaran": "cross-env node ./middleware/syncverifikasipelanggaran.middleware.js",
    "jtoTransactionCleanup": "cross-env node ./middleware/transactionCleanup.middleware.js",
    "jtoMvRefresh": "cross-env node ./middleware/runMvRefresh.js",
    "test-ci": "jest --coverage --forceExit",
    "make:model": "cross-env sequelize-cli model:generate --name",
    "make:migration": "cross-env sequelize-cli migration:generate --name",
    "make:seeder": "cross-env sequelize-cli seed:generate --name",
    "migrate": "cross-env sequelize-cli db:migrate",
    "migrate:rollback": "cross-env sequelize-cli db:migrate:undo",
    "db:seed": "cross-env sequelize-cli db:seed:all",
    "db:seed --seed": "cross-env sequelize-cli db:seed --seed",
    "db:seed:rollback": "cross-env sequelize-cli db:seed:undo --seed",
    "db:seed:rollback:all": "cross-env sequelize-cli db:seed:undo:all"
  },
  "jest": {
    "globals": {
      "__DEV__": true
    },
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
